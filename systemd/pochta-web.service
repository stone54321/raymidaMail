[Unit]
Description=Veb-pochta (Web API)
After=network.target

[Service]
Type=simple
Environment=RESEND_KEY=YOUR_RESEND_KEY_HERE
Environment=MAIL_DOMAIN=yourdomain.com
WorkingDirectory=%h/work
ExecStart=/usr/bin/python3 %h/work/pochta_api.py 8926
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
