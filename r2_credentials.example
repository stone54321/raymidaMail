# ==========================================
# Cloudflare R2 Credentials Template
# ==========================================
# 1. Copy this file to your home directory:
#    cp r2_credentials.example ~/.r2_credentials
# 2. Fill in the values with your keys from the Cloudflare Dashboard.
# 3. Set read-only permissions for the owner:
#    chmod 600 ~/.r2_credentials

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=mail-fallback-queue
